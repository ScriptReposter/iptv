<rml>
    <head><title>ProsperoTV - IPTV Smarters</title><link type="text/rcss" href="styles/app.rcss" /></head>
    <body>
        <div id="app-shell"><img id="app-background" src="images/background.tga" /><div id="safe-frame">
            <header id="topbar">
                <img id="brand-mark" src="icons/prosperotv.tga" width="56" height="56" alt="" />
                <div id="brand-block"><span id="brand-name">IPTV SMARTERS</span><span id="brand-version">PRO v{{PROSPERO_TV_VERSION}}</span></div>
                <nav id="primary-nav">
                    <button id="nav-live-tv" class="nav-item active tab-live"><span class="tab-label">LIVE TV</span></button>
                    <button id="nav-movies" class="nav-item tab-movies"><span class="tab-label">MOVIES</span></button>
                    <button id="nav-series" class="nav-item tab-series"><span class="tab-label">SERIES</span></button>
                    <button id="nav-favorites" class="nav-item tab-fav"><span class="tab-label">FAVORITES</span></button>
                    <button id="nav-sources" class="nav-item tab-sources"><span class="tab-label">SOURCES</span></button>
                </nav>
                <div id="header-status" class="status-inline"><span id="header-status-dot" class="status-dot ready"></span><span id="header-status-label">Account Active</span></div>
            </header>

            <main id="content-shell">
                <section id="screen-live-tv" class="screen">
                    <div id="live-tv-heading" class="screen-heading">LIVE TV</div><div id="live-tv-subtitle" class="screen-subtitle">Select a category to browse channels. Press L1 / R1 to switch between Live TV, Movies and Series.</div>
                    
                    <section id="source-region" class="rail-panel"><span class="panel-kicker">ACTIVE ACCOUNT</span><div class="rail-list">
                        <div id="source-slot-0" class="rail-item selected"><span id="source-name-0">Xtream Codes</span><span id="source-meta-0">IPTV Smarters Provider</span><span id="source-status-0" class="item-status">CONNECTED</span></div>
                        <div id="source-slot-1" class="rail-item hidden"><span id="source-name-1">Custom M3U</span><span id="source-meta-1">Playlist</span><span id="source-status-1" class="item-status">EMPTY</span></div>
                        <div id="source-slot-2" class="rail-item hidden"><span id="source-name-2">Backup Server</span><span id="source-meta-2">Xtream</span><span id="source-status-2" class="item-status">EMPTY</span></div>
                    </div></section>

                    <section id="group-region" class="rail-panel"><span class="panel-kicker">CATEGORIES</span><div class="rail-list">
                        <button id="group-slot-0" class="rail-item group-item selected"><span id="group-title-0">All Channels</span><span id="group-count-0">--</span></button>
                        <button id="group-slot-1" class="rail-item group-item"><span id="group-title-1">Favorites</span><span id="group-count-1">--</span></button>
                        <button id="group-slot-2" class="rail-item group-item"><span id="group-title-2">Recent</span><span id="group-count-2">--</span></button>
                        <button id="group-slot-3" class="rail-item group-item"><span id="group-title-3">Sports</span><span id="group-count-3">--</span></button>
                        <button id="group-slot-4" class="rail-item group-item"><span id="group-title-4">News</span><span id="group-count-4">--</span></button>
                        <button id="group-slot-5" class="rail-item group-item"><span id="group-title-5">Entertainment</span><span id="group-count-5">--</span></button>
                    </div></section>

                    <section id="search-region" class="rail-panel"><span class="panel-kicker">SEARCH &amp; FILTER</span><button id="search-input"><img src="icons/search.tga" width="32" height="32" alt=""/><span id="search-query">Search catalog</span><span id="search-clear" class="hidden">ACTIVE</span></button><span id="search-hint">Triangle opens advanced search</span></section>

                    <section id="channel-region"><div id="channel-list">
                        <button id="channel-slot-0" class="channel-card selected"><span id="channel-number-0" class="channel-number">1</span><span id="channel-logo-0" class="channel-logo">TV</span><span id="channel-name-0" class="channel-name">Channel</span><span id="channel-meta-0" class="channel-meta">Live Broadcast</span><span id="channel-live-0" class="live-marker">LIVE</span><span id="channel-favorite-0" class="favorite-marker">FAVORITE</span><span id="channel-recent-0" class="recent-marker">RECENT</span><span id="channel-playback-0" class="playback-marker">PLAYABLE</span><span id="channel-tech-0" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-1" class="channel-card"><span id="channel-number-1" class="channel-number">2</span><span id="channel-logo-1" class="channel-logo">TV</span><span id="channel-name-1" class="channel-name">Channel</span><span id="channel-meta-1" class="channel-meta">Live Broadcast</span><span id="channel-live-1" class="live-marker">LIVE</span><span id="channel-favorite-1" class="favorite-marker">FAVORITE</span><span id="channel-recent-1" class="recent-marker">RECENT</span><span id="channel-playback-1" class="playback-marker">PLAYABLE</span><span id="channel-tech-1" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-2" class="channel-card"><span id="channel-number-2" class="channel-number">3</span><span id="channel-logo-2" class="channel-logo">TV</span><span id="channel-name-2" class="channel-name">Channel</span><span id="channel-meta-2" class="channel-meta">Live Broadcast</span><span id="channel-live-2" class="live-marker">LIVE</span><span id="channel-favorite-2" class="favorite-marker">FAVORITE</span><span id="channel-recent-2" class="recent-marker">RECENT</span><span id="channel-playback-2" class="playback-marker">PLAYABLE</span><span id="channel-tech-2" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-3" class="channel-card"><span id="channel-number-3" class="channel-number">4</span><span id="channel-logo-3" class="channel-logo">TV</span><span id="channel-name-3" class="channel-name">Channel</span><span id="channel-meta-3" class="channel-meta">Live Broadcast</span><span id="channel-live-3" class="live-marker">LIVE</span><span id="channel-favorite-3" class="favorite-marker">FAVORITE</span><span id="channel-recent-3" class="recent-marker">RECENT</span><span id="channel-playback-3" class="playback-marker">PLAYABLE</span><span id="channel-tech-3" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-4" class="channel-card"><span id="channel-number-4" class="channel-number">5</span><span id="channel-logo-4" class="channel-logo">TV</span><span id="channel-name-4" class="channel-name">Channel</span><span id="channel-meta-4" class="channel-meta">Live Broadcast</span><span id="channel-live-4" class="live-marker">LIVE</span><span id="channel-favorite-4" class="favorite-marker">FAVORITE</span><span id="channel-recent-4" class="recent-marker">RECENT</span><span id="channel-playback-4" class="playback-marker">PLAYABLE</span><span id="channel-tech-4" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-5" class="channel-card"><span id="channel-number-5" class="channel-number">6</span><span id="channel-logo-5" class="channel-logo">TV</span><span id="channel-name-5" class="channel-name">Channel</span><span id="channel-meta-5" class="channel-meta">Live Broadcast</span><span id="channel-live-5" class="live-marker">LIVE</span><span id="channel-favorite-5" class="favorite-marker">FAVORITE</span><span id="channel-recent-5" class="recent-marker">RECENT</span><span id="channel-playback-5" class="playback-marker">PLAYABLE</span><span id="channel-tech-5" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-6" class="channel-card"><span id="channel-number-6" class="channel-number">7</span><span id="channel-logo-6" class="channel-logo">TV</span><span id="channel-name-6" class="channel-name">Channel</span><span id="channel-meta-6" class="channel-meta">Live Broadcast</span><span id="channel-live-6" class="live-marker">LIVE</span><span id="channel-favorite-6" class="favorite-marker">FAVORITE</span><span id="channel-recent-6" class="recent-marker">RECENT</span><span id="channel-playback-6" class="playback-marker">PLAYABLE</span><span id="channel-tech-6" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                        <button id="channel-slot-7" class="channel-card"><span id="channel-number-7" class="channel-number">8</span><span id="channel-logo-7" class="channel-logo">TV</span><span id="channel-name-7" class="channel-name">Channel</span><span id="channel-meta-7" class="channel-meta">Live Broadcast</span><span id="channel-live-7" class="live-marker">LIVE</span><span id="channel-favorite-7" class="favorite-marker">FAVORITE</span><span id="channel-recent-7" class="recent-marker">RECENT</span><span id="channel-playback-7" class="playback-marker">PLAYABLE</span><span id="channel-tech-7" class="channel-tech">AUTO | AUTO | FPS AUTO</span></button>
                    </div><span id="channel-empty" class="empty-state hidden">No items in this section.</span></section>

                    <aside id="channel-detail-region"><span class="panel-kicker">NOW PLAYING INFO</span><span id="selected-channel-number">--</span><span id="selected-channel-name">Select Content</span><span id="selected-channel-meta">Category &amp; Stream Info</span><span id="selected-channel-tech">AUTO | AUTO | FPS AUTO</span><span id="selected-channel-markers"><span id="selected-channel-favorite" class="favorite-marker">FAVORITE</span><span id="selected-channel-recent" class="recent-marker">RECENT</span><span id="selected-channel-playback" class="playback-marker">PLAYABLE</span></span><button id="channel-play-button" class="primary-action"><img src="icons/play.tga" width="24" height="24" alt=""/><span>WATCH NOW</span></button><div id="preview-status-region"><span id="preview-status-dot" class="status-dot ready"></span><span id="preview-status-title">Ready</span><span id="preview-status-message">Press Cross to start playback. Circle or Options returns.</span></div></aside>
                    <div id="live-status-region"><span id="live-status-dot" class="status-dot ready"></span><span id="live-status-label">IPTV Smarters Ready</span><span id="live-status-detail">Local cache active</span></div>
                    <div id="error-region" class="hidden"><span id="error-title">Unable to connect</span><span id="error-message">Check server credentials or open Sources.</span><button id="error-action"><span id="error-action-label">Retry</span></button></div>
                </section>

                <section id="screen-sources" class="screen hidden">
                    <div class="screen-heading">ACCOUNT &amp; SETTINGS</div><div class="screen-subtitle">Connect your Xtream Codes IPTV provider or custom playlist URL.</div>
                    <section id="source-management-region"><span class="panel-kicker">LOGIN CREDENTIALS</span><button id="source-management-slot-0" class="source-management-card selected"><span id="source-management-name-0">Xtream Codes Login</span><span id="source-management-url-0">Cross to enter Server URL, Username and Password</span><span id="source-management-health-0" class="item-status">ACTIVE</span><span id="source-management-action-0" class="source-action">CROSS: EDIT</span></button><button id="source-management-slot-1" class="source-management-card"><span id="source-management-name-1">Custom M3U URL</span><span id="source-management-url-1">Cross to enter an HTTP(S) M3U / M3U8 Playlist</span><span id="source-management-health-1" class="item-status">EMPTY</span><span id="source-management-action-1" class="source-action">CROSS: ADD</span></button><button id="source-management-slot-2" class="source-management-card"><span id="source-management-name-2">Secondary Server</span><span id="source-management-url-2">Cross to configure additional provider</span><span id="source-management-health-2" class="item-status">EMPTY</span><span id="source-management-action-2" class="source-action">CROSS: ADD</span></button></section>
                    <section id="source-status-region"><span class="panel-kicker">ACCOUNT OVERVIEW</span><span id="source-status-label">Active Provider</span><span id="source-status-detail">Select an account above to authenticate and load your Live TV, Movies and Series catalogs.</span><button id="source-refresh-button" class="primary-action"><span id="source-refresh-label">Refresh &amp; Sync Catalog</span></button></section>
                </section>
            </main>

            <section id="search-overlay" class="hidden"><div id="search-panel"><span class="overlay-kicker">SEARCH CATALOG</span><span class="overlay-title">Find Live TV, Movies &amp; Series</span><span id="search-help">Cross changes a filter. Results update instantly.</span><button id="search-query-button"><span class="filter-label">KEYWORD SEARCH</span><span id="search-query-value">Search by title or category</span></button><div id="filter-row"><button id="filter-country" class="filter-button"><span class="filter-label">COUNTRY / REGION</span><span id="filter-country-value">All regions</span></button><button id="filter-category" class="filter-button"><span class="filter-label">CATEGORY</span><span id="filter-category-value">All categories</span></button><button id="filter-language" class="filter-button"><span class="filter-label">LANGUAGE</span><span id="filter-language-value">All languages</span></button><button id="filter-quality" class="filter-button"><span class="filter-label">QUALITY</span><span id="filter-quality-value">Any quality</span></button></div><span id="search-result-count">0 items found</span><button id="search-reset"><span>Reset</span></button><button id="search-apply" class="primary-action"><span>Show results</span></button></div></section>

            <footer id="controller-footer"><span class="controller-hint hint-0"><img src="icons/cross.tga" width="34" height="34" alt=""/><span>Watch</span></span><span class="controller-hint hint-1"><img src="icons/circle.tga" width="34" height="34" alt=""/><span>Back</span></span><span class="controller-hint hint-2"><img src="icons/square.tga" width="34" height="34" alt=""/><span>Favorite</span></span><span class="controller-hint hint-3"><img src="icons/triangle.tga" width="34" height="34" alt=""/><span id="triangle-hint-label">Search</span></span><span class="controller-hint hint-4"><span class="control-glyph">L1 / R1</span><span>Live / Movies / Series</span></span><span class="controller-hint hint-5"><img src="icons/options.tga" width="34" height="34" alt=""/><span>Sync</span></span><span id="footer-status"><span id="footer-status-dot" class="status-dot ready"></span><span id="footer-status-label">Connected</span></span></footer>
        </div></div>
    </body>
</rml>
